# Netlify serves .webmanifest as octet-stream by default; browsers want this.
/manifest.webmanifest
  Content-Type: application/manifest+json

# Bell's reminders worker: always the newest, never a cached copy.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# The old Movement app's workers: retired (see service-worker.js). Always
# fetched fresh, so every phone that still has one picks up the retirement.
/service-worker.js
  Cache-Control: no-cache
/firebase-messaging-sw.js
  Cache-Control: no-cache
